<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/navy_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Avatar Initial -->
        <FrameLayout
            android:id="@+id/avatarFrame"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_avatar_circle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvAvatarText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="A" />
        </FrameLayout>

        <!-- Call Type Icon -->
        <ImageView
            android:id="@+id/ivCallType"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/type_incoming"
            app:layout_constraintStart_toEndOf="@id/avatarFrame"
            app:layout_constraintTop_toTopOf="@id/avatarFrame"
            app:tint="@color/call_incoming"
            tools:src="@drawable/ic_incoming_call" />

        <!-- Title / Name -->
        <TextView
            android:id="@+id/tvCallerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnCall"
            app:layout_constraintStart_toEndOf="@id/ivCallType"
            app:layout_constraintTop_toTopOf="@id/avatarFrame"
            tools:text="Alex Rivera" />

        <!-- Phone Number & Duration -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/tvCallerTitle"
            app:layout_constraintStart_toStartOf="@id/ivCallType"
            app:layout_constraintTop_toBottomOf="@id/tvCallerTitle"
            tools:text="(555) 234-5678 • 2m 15s" />

        <!-- Date / Time -->
        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/avatarFrame"
            app:layout_constraintEnd_toEndOf="@id/tvCallerTitle"
            app:layout_constraintStart_toStartOf="@id/ivCallType"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            tools:text="Today, 10:45 AM" />

        <!-- Call Action Button -->
        <ImageButton
            android:id="@+id/btnCall"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_call_button"
            android:contentDescription="@string/action_call"
            android:padding="10dp"
            android:src="@drawable/ic_call"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
