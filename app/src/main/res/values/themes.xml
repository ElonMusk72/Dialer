<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dialer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/navy_surface</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/navy_background</item>
        <item name="colorSurface">@color/navy_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/navy_background</item>
        <item name="android:navigationBarColor">@color/navy_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
